APP_NAME=Laravel
APP_ENV=local
# Use stderr so you can see logs using 'docker logs'
LOG_CHANNEL=stderr
LOG_LEVEL=debug
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_KEY=base64:ZDUFN76I0eaNT6mfoj9H7vh3xE9/yqP3vySrqsy3r90=
CIPHERSWEET_KEY=e2f9a2d1772d52e64c42b24259451789b7562572c3c8ce6dfeb82053346743c9

# 1. Main storage
FILESYSTEM_DISK=s3

# 2. Livewire temporary files
LIVEWIRE_TEMP_FILE_DISK=s3
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Database
DB_CONNECTION=sqlite
# DB_HOST/PORT/USER/PASS are ignored for SQLite

# --- REDIS CONFIGURATION ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=redis
QUEUE_CONNECTION=sync
CACHE_STORE=redis

MEMCACHED_HOST=host.docker.internal

# CRITICAL CHANGE: Point to host machine
REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CRITICAL CHANGE: Point to host machine for MinIO
AWS_ENDPOINT=http://host.docker.internal:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sanago
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
OCTANE_SERVER=frankenphp
GITHUB_TOKEN=
