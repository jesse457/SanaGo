# Git files
.git
.gitignore
.gitattributes
.github

# Environment files (NEVER include in image)
.env
.env.*
!.env.example

# Dependencies (will be installed in container)
node_modules
vendor

# Build artifacts (will be generated in container)
public/build
public/hot
public/storage

# Development files
tests
*.md
README.md
CHANGELOG.md
phpunit.xml
.phpunit.result.cache

# IDE files
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files
Dockerfile
docker-compose.yml
docker-compose.*.yml

# Logs
storage/logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Monitoring (not needed in app container)
monitoring

# Cache
bootstrap/cache/*.php
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
